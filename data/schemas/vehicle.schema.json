{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-library.local/schemas/vehicle.schema.json",
  "title": "FinancialLibraryVehicle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "category",
    "liquidity",
    "risk_notes",
    "literacy_angle",
    "source_types",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "country": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 3166-1 alpha-2 lowercase"
    },
    "category": {
      "type": "string",
      "enum": [
        "bank-deposit",
        "government-scheme",
        "pension",
        "regulated-fund",
        "cooperative",
        "mobile-money-savings",
        "postal-savings",
        "other-regulated"
      ]
    },
    "liquidity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "locked-term"
      ]
    },
    "suitability_notes": {
      "type": "string",
      "maxLength": 800
    },
    "risk_notes": {
      "type": "string",
      "minLength": 20,
      "maxLength": 800
    },
    "literacy_angle": {
      "type": "string",
      "minLength": 20,
      "maxLength": 800
    },
    "source_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "central-bank",
          "securities-regulator",
          "treasury",
          "ministry",
          "government-portal",
          "postal",
          "pension-regulator"
        ]
      }
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "docs_path": {
      "type": "string",
      "description": "Relative path under docs/vehicles/ when page exists"
    },
    "status": {
      "type": "string",
      "enum": [
        "stub",
        "draft",
        "published"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
